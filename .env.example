# Core runtime
PORT=3000
APP_API_TOKEN=
STORAGE_PATH=./storage
WORKER_CONCURRENCY=1

# Budget guardrails
EXPERIMENT_BUDGET_USD=20
EXPERIMENT_RESERVE_USD=2

# Persistence / workers (required before production deployment)
DATABASE_URL=postgresql://shorts_factory:change-me@postgres:5432/shorts_factory
REDIS_URL=redis://redis:6379

# AI providers - never expose these values to the browser
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_IMAGE_MODEL=
TTS_PROVIDER=
TTS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Music generation and library
MUSIC_LIBRARY_PATH=./storage/music-library
AI_MUSIC_PROVIDER=suno  # Options: suno, mubert, musicgen, disabled
AI_MUSIC_API_KEY=
SUNO_API_KEY=
MUBERT_API_KEY=
MUSIC_GENERATION_ENABLED=true

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# For local development:
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# For production (replace with your actual domain):
YOUTUBE_REDIRECT_URI=https://yourdomain.com/api/youtube/callback
